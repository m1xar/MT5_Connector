# Every setting also reads the bare name (DATABASE_URL) if the prefixed one is absent.

MT5_API_DATABASE_URL=postgresql+psycopg://mt5_api:mt5_api_pass@localhost:5432/mt5_api

# Postgres connections the API keeps open, and how many more it may open under
# load: 80 in total, sized for fifty hard syncs arriving at once with room to
# spare. Requests only hold a connection while they read or write. Postgres
# ships with max_connections=100; docker-compose.dev.yml raises it to 200, and
# a production database has to allow at least the sum of these two plus
# whatever else connects to it.
MT5_API_DB_POOL_SIZE=30
MT5_API_DB_MAX_OVERFLOW=50

# One path per terminal installation, ';'-separated. This list is the pool size:
# about two terminals per core, measured; more only cost memory. Every
# account is pinned to one of these paths when it is registered and keeps that
# exact string; renaming, reordering or removing a path orphans its accounts,
# which are re-pinned to the least-loaded remaining terminal on their next sync.
MT5_API_TERMINAL_PATHS=C:\MT5\t1\terminal64.exe;C:\MT5\t2\terminal64.exe;C:\MT5\t3\terminal64.exe

# Launch each terminal with /portable so it keeps its data next to the exe
# instead of %APPDATA%\MetaQuotes. Must match how the installs were set up.
MT5_API_TERMINAL_PORTABLE=true

# A terminal that cannot reach the server never answers the IPC channel at all,
# so a connect that has not landed in 30s is not going to. The exception is an
# account's very first sync, which has never been proven and gets 120s - it may
# also have to cold-start a terminal.
MT5_API_TERMINAL_INIT_TIMEOUT_MS=30000
MT5_API_TERMINAL_LOGIN_TIMEOUT_MS=30000
MT5_API_TERMINAL_INITIAL_CONNECT_TIMEOUT_MS=120000

# login() returns before the terminal has finished downloading the
# account's deal history - measured at 0 deals on return and 188 two seconds
# later. How long to wait for the count to settle; a zero at the end of the
# window is not an error, the read is classified afterwards.
MT5_API_HISTORY_SETTLE_TIMEOUT_SECONDS=10

# A broker that withholds the deal history from a second session (a master
# password while the owner's terminal is connected) is not a connection
# failure: the account keeps its figures and open positions and the scheduler
# leaves it alone for this long. A hard sync ignores the pause.
MT5_API_HISTORY_WITHHELD_PAUSE_MINUTES=60

# How stale an account may get before the scheduler re-queues it.
MT5_API_SYNC_INTERVAL_MINUTES=15
MT5_API_SYNC_SCHEDULER_TICK_SECONDS=60
# Enriching a few hundred positions with MAE/MFE takes minutes the first
# time, while the terminal is still pulling minute history for each symbol.
MT5_API_SYNC_TASK_TIMEOUT_SECONDS=900
MT5_API_HARD_SYNC_WAIT_TIMEOUT_SECONDS=900
MT5_API_MAX_TASK_RETRIES=2

# Consecutive syncs that failed to connect - IPC timeouts, refused
# credentials, a lost terminal - before an account is marked
# error_connection. A failed *initial* sync marks it immediately, regardless
# of this. Withheld history is not a failure and does not count.
MT5_API_ACCOUNT_ERROR_THRESHOLD=3
MT5_API_WORKER_START_TIMEOUT_SECONDS=120

# MAE/MFE requires pulling candles for every position - the slowest part of a
# sync. RR is unaffected by this flag; it needs no candles.
MT5_API_ENRICH_MAE_MFE=true

# Drop each terminal's price cache after every sync it finishes. The terminal
# materialises whole years for any window it is asked for, so the cache grows
# without bound otherwise - four instances reached 4.3 GB after a handful of
# syncs of three accounts, and ~250 MB with this on. Nothing is kept: a later
# sync re-fetches the little it needs, since MAE/MFE is measured once per
# position and the clock is held in memory between syncs.
MT5_API_PRUNE_CACHE_AFTER_SYNC=true

# Empty disables auth entirely - only acceptable on a closed network.
MT5_API_API_TOKEN=
MT5_API_API_HOST=0.0.0.0
MT5_API_API_PORT=8030
MT5_API_CORS_ALLOW_ORIGIN=*

MT5_API_LOG_LEVEL=INFO
MT5_API_LOG_JSON=true
